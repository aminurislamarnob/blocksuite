{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blocksuite/accordion",
  "version": "0.1.0",
  "title": "Accordion",
  "category": "blocksuite",
  "icon": "list-view",
  "description": "Accordion wrapper for accordion items.",
  "textdomain": "blocksuite",
  "keywords": ["accordion", "toggle", "faq"],
  "attributes": {
    "allowMultipleOpen": {
      "type": "boolean",
      "default": false
    },
    "startCollapsed": {
      "type": "boolean",
      "default": false
    },
    "openPane": {
      "type": "number",
      "default": 0
    }
  },
  "supports": {
    "align": ["wide", "full"],
    "html": false,
    "spacing": {
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}
